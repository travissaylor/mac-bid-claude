filters:
  and:
    - file.folder == "reports"
    - file.name.startsWith("lot-")
    - status == "watching"
formulas:
  deal_score: ((max_bid - current_bid) / max_bid * 100).toFixed(1)
  past_max: current_bid >= max_bid
  headroom: (max_bid - current_bid).toFixed(2)
  link: file.asLink(title)
properties:
  formula.deal_score:
    displayName: Deal score
  formula.past_max:
    displayName: Past max
  formula.headroom:
    displayName: Headroom
  formula.link:
    displayName: Lot
  note.warehouse_name:
    displayName: Warehouse
  note.current_bid:
    displayName: Current
  note.max_bid:
    displayName: Max
  note.max_bid_floor:
    displayName: Max (floor)
  note.closes_at:
    displayName: Closes
  note.condition:
    displayName: Condition
views:
  - type: table
    name: Active watchlist
    order:
      - formula.link
      - warehouse_name
      - condition
      - current_bid
      - max_bid
      - max_bid_floor
      - formula.headroom
      - formula.deal_score
      - closes_at
      - formula.past_max
    sort:
      - property: closes_at
        direction: ASC
  - type: table
    name: Past max (defend or concede)
    filters:
      and:
        - current_bid >= max_bid
    order:
      - formula.link
      - current_bid
      - max_bid
      - max_bid_floor
      - closes_at
    sort:
      - property: closes_at
        direction: ASC
